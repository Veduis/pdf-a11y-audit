{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Veduis/pdf-a11y-audit",
  "title": "PDF Accessibility Audit",
  "description": "Local-first PDF accessibility audits with cited findings and an offline HTML report.",
  "version": "0.1.0",
  "websiteUrl": "https://remediatepdf.com/open/pdf-a11y-audit",
